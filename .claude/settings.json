    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "stripe@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "deepeval@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "huggingface-skills@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "hyperframes@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "superdesign@claude-plugins-official": false
  },
  "enabledMcpjsonServers": [
    "github"
  ],
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
